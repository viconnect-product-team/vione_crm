# Supabase (Lovable Cloud) — publishable/anon values only. Never put service_role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side mirrors (used during SSR / server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Integration / e2e tests — STAGING ONLY.
#
# Point these at the STAGING Supabase project, NEVER production. The guard in
# src/__tests__/helpers/test-env.ts (`requireStagingSupabase`) hard-fails when
# SUPABASE_URL resolves to the production host or an unknown host without
# SUPABASE_TEST_ENV=staging.
#
# In CI (.github/workflows/pr-integration.yml) these come from the "staging"
# GitHub Environment: STAGING_SUPABASE_URL / _PUBLISHABLE_KEY / _SERVICE_ROLE_KEY.
# ---------------------------------------------------------------------------
# SUPABASE_TEST_ENV=staging
# SUPABASE_SERVICE_ROLE_KEY=      # staging service role — never commit

# NestJS Backend API URL
VITE_API_URL=http://localhost:3000

# Client IDs for Google & Apple Sign-In
VITE_GOOGLE_CLIENT_ID=your-google-client-id-web.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.vione.connect.web

