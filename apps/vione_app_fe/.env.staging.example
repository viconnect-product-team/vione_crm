# =============================================================================
# Business Connect — STAGING environment template (BC-INFRA-STG-01)
# CHỈ TÊN BIẾN. TUYỆT ĐỐI KHÔNG COMMIT GIÁ TRỊ THẬT.
# Mọi biến dưới đây phải trỏ tới dự án Supabase STAGING (khác ref production).
# =============================================================================

# --- Frontend staging (build-time) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server-side staging (SSR / server functions) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bắt buộc để mở khoá các suite live-DB ---
SUPABASE_TEST_ENV=staging

# --- CI (GitHub Environment "staging") ---
STAGING_SUPABASE_URL=
STAGING_SUPABASE_PUBLISHABLE_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# --- Tài khoản test tổng hợp (chỉ đặt trong secret store, không đặt trong code) ---
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
TEST_USER_C_EMAIL=
TEST_USER_C_PASSWORD=

# --- Bí mật máy chủ theo yêu cầu RC1 (giá trị staging riêng, không dùng lại production) ---
LOVABLE_API_KEY=
NOTIFICATION_RUNTIME_CRON_SECRET=
OUTCOME_CONSUMER_CRON_SECRET=
TIMELINE_PROJECTION_CRON_SECRET=
IDENTITY_QR_SIGNING_SECRET=

# --- Tuỳ chọn theo tính năng đang bật ---
AI_PROVIDER=
AI_REAL_PROVIDER_ENABLED=
OPENAI_API_KEY=
OPENAI_MODEL=
VITE_APPLE_WALLET_ENABLED=
VITE_GOOGLE_WALLET_ENABLED=
VITE_WALLET_PASS_ENDPOINT=
