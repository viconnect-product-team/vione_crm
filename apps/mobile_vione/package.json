{
  "name": "@vibe/mobile_vione",
  "version": "1.0.0",
  "description": "ViOne Business Connect Native Mobile App (React Native & Expo)",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "npx eas-cli build --profile preview --platform android",
    "build:aab": "npx eas-cli build --profile production --platform android",
    "build:ipa": "npx eas-cli build --profile production --platform ios --non-interactive",
    "build:ios:prod": "npx eas-cli build --profile production --platform ios --non-interactive",
    "build:ios:submit": "npx eas-cli build --profile production --platform ios --auto-submit --non-interactive",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.1",
    "expo": "~52.0.37",
    "expo-asset": "~11.0.4",
    "expo-camera": "~16.0.17",
    "expo-clipboard": "~7.0.1",
    "expo-linear-gradient": "~14.0.2",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-qrcode-svg": "^6.3.14",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.8.3"
  },
  "private": true
}
