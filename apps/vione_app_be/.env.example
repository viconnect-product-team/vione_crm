PORT=3000
DATABASE_URL="postgresql://app1:password@localhost:5432/postgres?schema=public"
JWT_SECRET="super-secret-jwt-key"
SUPABASE_JWT_SECRET="super-secret-jwt-key-with-at-least-32-characters-long"


# Google Client IDs
GOOGLE_CLIENT_ID_WEB="your-google-client-id-for-web.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_IOS="your-google-client-id-for-ios.apps.googleusercontent.com"

# Apple OAuth Credentials (Required for Sign In with Apple)
APPLE_BUNDLE_ID="com.vione.connect.app"
APPLE_SERVICE_ID="com.vione.connect.web"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_KEY_ID="YOUR_APPLE_KEY_ID"
# Content of .p8 file (private key from Apple, single line or multiline PEM format)
APPLE_PRIVATE_KEY="YOUR_APPLE_PRIVATE_KEY_PEM_CONTENT"
