{
  "name": "vione-standalone-monorepo",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "powershell -ExecutionPolicy Bypass -File ./dev.ps1",
    "dev:fe": "npm run dev --prefix apps/vione_app_fe",
    "dev:be": "npm run dev --prefix apps/vione_app_be",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ./build-apk.ps1",
    "build:apk:release": "powershell -ExecutionPolicy Bypass -File ./build-apk.ps1 -Release",
    "build:apk:clean": "powershell -ExecutionPolicy Bypass -File ./build-apk.ps1 -Clean",
    "build:ipa": "powershell -ExecutionPolicy Bypass -File ./build-ipa.ps1",
    "build:ipa:prod": "powershell -ExecutionPolicy Bypass -File ./build-ipa.ps1 -Profile production",
    "build:ipa:submit": "powershell -ExecutionPolicy Bypass -File ./build-ipa.ps1 -Profile production -Submit",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1",
    "deploy:fe": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -FrontendOnly -SkipWebBuild",
    "deploy:be": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -BackendOnly",
    "docker:up": "powershell -ExecutionPolicy Bypass -File ./dev.ps1 -Docker",
    "docker:down": "powershell -ExecutionPolicy Bypass -File ./dev.ps1 -Down"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.2.5",
    "turbo": "^2.1.2",
    "typescript": "^5.8.3"
  }
}
